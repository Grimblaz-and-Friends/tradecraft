{
  "schema_version": 1,
  "rules": [
    {
      "name": "runtime-or-user-surface",
      "include": [
        "agents/**",
        "commands/**",
        "hooks/**",
        "lib/**",
        "skills/**",
        ".claude-plugin/**"
      ],
      "exclude": [
        "**/tests/**",
        "**/test_*.py",
        "**/*_test.py"
      ]
    }
  ],
  "version": {
    "path": ".claude-plugin/plugin.json",
    "field": "version",
    "increment": "minor"
  }
}
