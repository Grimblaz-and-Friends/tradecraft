{
  "schema_version": 1,
  "rules": [
    {
      "name": "runtime-or-user-surface",
      "include": [
        "agents/**",
        "commands/**",
        "hooks/**",
        "lib/**",
        "skills/**",
        ".claude-plugin/**"
      ],
      "exclude": [
        "**/tests/**",
        "**/test_*.py",
        "**/*_test.py"
      ]
    }
  ],
  "version": {
    "path": ".claude-plugin/plugin.json",
    "field": "version",
    "increment": "minor"
  },
  "floor": {
    "jobs": [
      {
        "workflow": ".github/workflows/ci.yml",
        "job": "lint-and-test (ubuntu-latest)"
      },
      {
        "workflow": ".github/workflows/ci.yml",
        "job": "lint-and-test (windows-latest)"
      },
      {
        "workflow": ".github/workflows/ask-declaration.yml",
        "job": "ask-declaration"
      }
    ],
    "stall_after_seconds": 3600
  }
}
