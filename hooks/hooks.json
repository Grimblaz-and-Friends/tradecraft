{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "set -- `# <#`\n[ -n \"$CLAUDE_CODE_REMOTE\" ] && exec python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/cloud.py\" stop || true\n#>",
            "shell": "bash"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "set -- `# <#`\n[ -n \"$CLAUDE_CODE_REMOTE\" ] && exec python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/cloud.py\" prompt || true\n#>",
            "shell": "bash"
          }
        ]
      }
    ]
  }
}
